# ─────────────────────────────────────────────────────────────────
# System noise
# ─────────────────────────────────────────────────────────────────
# macOS AppleDouble on FAT filesystems (e.g. CIRCUITPY)
._*
.Trashes
.fseventsd
.metadata_never_index
.DS_Store

# Python
__pycache__/
*.pyc
*.tmp
.pytest_cache/
.venv-platformio/
.pio/

# Editor
.vscode/
*.swp
.superpowers/

# Bundle download cache
.cache/

# ─────────────────────────────────────────────────────────────────
# Repo layout policy
#
#   src/      — Python source (committed, small text files)
#   assets/   — curated source art required for reproducible builds.
#   build/    — generated output, deployed to Pico.
#               CONTENTS ARE COMMITTED so other devs get the same
#               starting point. Regenerate locally with `make build`.
#   tests/    — pytest, committed
#   docs/     — committed
#   .plan/    — committed
#
# Anything else is legacy or vendored.
# ─────────────────────────────────────────────────────────────────

# Track only the source art used by the current build. Legacy atlases,
# vendored CircuitPython libraries and experiments remain local.
assets/*
!assets/backgrounds/
assets/backgrounds/*
!assets/backgrounds/bg5 1.png
!assets/digimon/
assets/digimon/*
!assets/digimon/digimon1/
assets/digimon/digimon1/*
!assets/digimon/digimon1/rookie/
!assets/digimon/digimon1/champion/
!assets/digimon/digimon1/ultimate/
!assets/digimon/digimon1/egg/
!assets/digimon/digimon1/baby/
assets/digimon/digimon1/egg/*
assets/digimon/digimon1/baby/*
!assets/digimon/digimon1/egg/idle/
!assets/digimon/digimon1/baby/idle/
assets/digimon/digimon1/egg/idle/*
assets/digimon/digimon1/baby/idle/*
!assets/digimon/digimon1/egg/idle/*.png
!assets/digimon/digimon1/baby/idle/*.png
assets/digimon/digimon1/rookie/*
assets/digimon/digimon1/champion/*
assets/digimon/digimon1/ultimate/*
!assets/digimon/digimon1/rookie/idle/
!assets/digimon/digimon1/champion/idle/
!assets/digimon/digimon1/ultimate/idle/
assets/digimon/digimon1/rookie/idle/*
assets/digimon/digimon1/champion/idle/*
assets/digimon/digimon1/ultimate/idle/*
!assets/digimon/digimon1/rookie/idle/*.png
!assets/digimon/digimon1/champion/idle/*.png
!assets/digimon/digimon1/ultimate/idle/*.png
!assets/ui/
assets/ui/*
!assets/ui/icons/
assets/ui/icons/*
!assets/ui/icons/*.png
build-tdisplay/
out/

# Native T-Display assets are regenerated by make build-tdisplay.
firmware/t-display/data/*
!firmware/t-display/data/.gitkeep
firmware/t-display/include/generated/*
!firmware/t-display/include/generated/.gitkeep

