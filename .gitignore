# ─────────────────────────────────────────────────────────────────
# System noise
# ─────────────────────────────────────────────────────────────────
# macOS AppleDouble on FAT filesystems (e.g. CIRCUITPY)
._*
.Trashes
.fseventsd
.metadata_never_index
.DS_Store

# Python
__pycache__/
*.pyc
*.tmp
.pytest_cache/
.venv-platformio/
.pio/

# Editor
.vscode/
*.swp

# Bundle download cache
.cache/

# ─────────────────────────────────────────────────────────────────
# Repo layout policy
#
#   src/      — Python source (committed, small text files)
#   assets/   — raw art, NOT deployed. Dev only. NEVER committed.
#   build/    — generated output, deployed to Pico.
#               CONTENTS ARE COMMITTED so other devs get the same
#               starting point. Regenerate locally with `make build`.
#   tests/    — pytest, committed
#   docs/     — committed
#   .plan/    — committed
#
# Anything else is legacy or vendored.
# ─────────────────────────────────────────────────────────────────

# assets/ is dev-only. Sprites/icons/backgrounds raw sources go here
# but you commit build/Placeholder/ etc instead.
assets/
build-tdisplay/
out/

# Native T-Display assets are regenerated by make build-tdisplay.
firmware/t-display/data/*
!firmware/t-display/data/.gitkeep
firmware/t-display/include/generated/*
!firmware/t-display/include/generated/.gitkeep

# Legacy dirs that may still exist from older code paths
Egg/
Greymon/
Greymon_32/
MetalGreymon/
WarGreymon/
Gabumon/
Garurumon/
WereGarurumon/
MetalGarurumon/
Agumon_atlas/
sprites/
sprites_clean/
sprites_raw/
reference/
mockups/
fonts/
icons/
pygame_v1/
lib/
!firmware/t-display/lib/
!firmware/t-display/lib/vpet_core/
!firmware/t-display/lib/vpet_core/src/
!firmware/t-display/lib/vpet_core/src/vpet/
!firmware/t-display/lib/vpet_core/src/vpet/*.h
!firmware/t-display/lib/vpet_core/src/vpet/*.cpp
_backup_v6/

# Old code.py versions (before we moved to src/+ build/)
code.py.v7
code.py.v13tmp
code.py.bak
code.py.old
code.py.new
code_pico_lcd144_v13.py
code_v7_backup.py
PLAN.md
